# Production Environment Variables
# Copy this file to .env and update with your production values

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your-strong-password-here-change-this
DB_NAME=locker_storage
DB_PORT=5432

# Application Configuration
PORT=8080
GIN_MODE=release

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRY=168h

# CORS Configuration (update with your frontend domain)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Database URL (auto-generated from above, or set manually)
DATABASE_URL=postgres://postgres:your-strong-password-here-change-this@postgres:5432/locker_storage?sslmode=disable
